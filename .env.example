# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- Required ---
# MongoDB connection string from MongoDB Atlas (Connect > Drivers)
MONGODB_URI=
# Long random string used to sign login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Recommended ---
# Public address of the site. Used in password reset links.
SITE_URL=http://localhost:3000
# Comma-separated emails allowed to open /admin. Create these accounts yourself first.
ADMIN_EMAILS=

# --- Optional: sending email (welcome, enrollment and password reset emails) ---
# Without these, emails are printed in the server terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeNest Academy <no-reply@codenest.academy>"
